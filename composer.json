{
    "name": "emotality/panacea-laravel",
    "description": "Laravel package to send transactional SMSes via PanaceaMobile.",
    "type": "library",
    "keywords": [
        "laravel",
        "panacea",
        "panaceamobile",
        "sms",
        "transactional sms"
    ],
    "license": "MIT",
    "homepage": "https://github.com/emotality/panacea-laravel",
    "authors": [
        {
            "name": "Jean-Pierre Fourie",
            "homepage": "https://emotality.com",
            "email": "jp@emotality.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/http": ">10.0",
        "illuminate/support": ">10.0"
    },
    "require-dev": {
        "laravel/pint": "^1.15",
        "orchestra/testbench": "^8.37 || ^9.17 || ^10.11 || ^11.1",
        "pestphp/pest": "^2.0.2 || ^3.8 || ^4.6 || 5.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Emotality\\Panacea\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emotality\\Panacea\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emotality\\Panacea\\PanaceaMobileServiceProvider"
            ],
            "aliases": {
                "PanaceaMobile": "Emotality\\Panacea\\PanaceaMobile"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
